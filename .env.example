# ── Secrets (required) ─────────────────────────────────────────────
# Signs session cookies. At least 32 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"
# Initial admin account, created on first start (the password is never overwritten later).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_FULL_NAME="Administrator"

# ── PostgreSQL container ───────────────────────────────────────────
# Use only URL-safe characters in the password (letters, digits, - _ .).
POSTGRES_USER="turan"
POSTGRES_PASSWORD="turan"
POSTGRES_DB="turan_math"
POSTGRES_PORT=5432

# Used by `npm run dev` and prisma on your machine. The app container builds its own.
DATABASE_URL="postgresql://turan:turan@localhost:5432/turan_math"

# ── App ────────────────────────────────────────────────────────────
APP_PORT=3000
# Set to true once served over HTTPS. Over plain http:// it must stay false or login fails.
COOKIE_SECURE=false
# Extra hosts (comma-separated) allowed to submit forms when the app is reached
# through a proxy or tunnel that rewrites headers. localhost:3000 is always
# allowed (covers VS Code port forwarding / dev tunnels). Needs a rebuild.
SERVER_ACTIONS_ALLOWED_ORIGINS=""
# true = load synthetic "[Sample]" questions on start (development only).
SEED_SAMPLE_QUESTIONS=false

# Desmos API key; the default is Desmos' public demo key (development only).
# Request a production key at https://www.desmos.com/api . Changing it needs a rebuild.
NEXT_PUBLIC_DESMOS_API_KEY="dcb31709b452b1cf9dc26972add0fda6"
