{
  "name": "turan-math",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:samples": "tsx prisma/seed-samples.ts",
    "postinstall": "prisma generate",
    "docker:up": "docker compose up -d --build",
    "docker:db": "docker compose up -d db",
    "cbqb:scrape": "tsx scripts/cbqb/scrape.ts",
    "questions:reset": "npm run -s db:prepare && tsx scripts/reset-question-bank.ts",
    "questions:rebuild": "npm run -s db:prepare && tsx scripts/rebuild-question-bank.ts",
    "questions:import": "npm run -s db:prepare && tsx scripts/import-questions.ts",
    "db:prepare": "prisma generate >/dev/null && prisma migrate deploy",
    "questions:check": "npm run -s db:prepare && tsx scripts/check-questions.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "katex": "^0.19.1",
    "next": "^15.5.28",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "dotenv": "^18.0.9",
    "linkedom": "^0.18.15",
    "mathml-to-latex": "^1.8.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
